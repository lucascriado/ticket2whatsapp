# Token atual (atualizado automaticamente pelo silent renewal)
TICKET_ACCESS_TOKEN=
TICKET_TOKEN_EXPIRES_AT=

# Cookie SSO do Azure B2C — renovado automaticamente via reauth
B2C_SSO_COOKIE=

# Credenciais para reauth automático (Puppeteer + Gmail IMAP)
# O portal trocou o login de e-mail para CPF: 11 dígitos ou 000.000.000-00.
TICKET_CPF=
TICKET_EMAIL=          # fallback do template antigo; hoje o login é o CPF
TICKET_PASSWORD=
GMAIL_APP_PASSWORD=   # senha de app do Google (não a senha normal)

# O cartão é resolvido em tempo de execução pela API da carteira
# (services/ticket.js), então não há variável de ID de cartão.
X_USER_ID=

# Azure B2C
B2C_TENANT=
B2C_POLICY=
B2C_CLIENT_ID=

PORT=3000

# Evolution API
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
WEBHOOK_URL=
INSTANCE_PHONE=
