# Token atual (atualizado automaticamente pelo silent renewal)
TICKET_ACCESS_TOKEN=
TICKET_TOKEN_EXPIRES_AT=

# Cookie SSO do Azure B2C — renovado automaticamente via reauth
B2C_SSO_COOKIE=

# Credenciais para reauth automático (Puppeteer + Gmail IMAP)
# O portal trocou o login de e-mail para CPF: 11 dígitos ou 000.000.000-00.
TICKET_CPF=
TICKET_EMAIL=          # fallback do template antigo; hoje o login é o CPF
TICKET_PASSWORD=
GMAIL_APP_PASSWORD=   # senha de app do Google (não a senha normal)

# O cartão é resolvido em tempo de execução pela API da carteira
# (services/ticket.js), então não há variável de ID de cartão.
X_USER_ID=

# Azure B2C
B2C_TENANT=
B2C_POLICY=
B2C_CLIENT_ID=

PORT=3000

# Evolution API
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
WEBHOOK_URL=

# Quem pode consultar o cartão, separado por vírgula, com DDI e DDD
# (ex.: 5517999999999). Vazio = qualquer um consulta — não deixe assim quando
# o bot estiver num número dedicado.
ALLOWED_NUMBERS=

# --- Provider de WhatsApp -----------------------------------------------
# Qual gateway usar. Os dois caminhos ficam vivos durante a migração:
# "evolution" mantém o comportamento de sempre; "openwa" usa o gateway novo.
# Voltar atrás é trocar esta variável — a única parte do rollback que não
# exige reparear o número.
WA_PROVIDER=evolution

# Ligar só durante a migração: imprime o evento cru do webhook, que é como se
# confere a FORMA do payload do provider novo contra um evento real.
# WA_LOG_RAW_EVENT=false

# Usados quando WA_PROVIDER=openwa
# OPENWA_URL=http://openwa:2785
# OPENWA_API_KEY=
# OPENWA_SESSION=
# Segredo do HMAC do webhook. A Evolution não tinha equivalente: lá o webhook
# era aberto a quem soubesse a URL.
# OPENWA_WEBHOOK_SECRET=
